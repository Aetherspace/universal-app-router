{
  "name": "@app/docs",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "next": "16.2.1",
    "next-themes": "^0.4.4",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1"
  },
  "devDependencies": {
    "pagefind": "1.4.0"
  },
  "optionalDependencies": {
    "@napi-rs/simple-git-linux-x64-gnu": "0.1.22",
    "@pagefind/linux-x64": "1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false",
    "predev": "node -e \"const fs=require('fs'); const p=require.resolve('nextra-theme-docs/style.css'); fs.cpSync(p,'public/nextra-theme-docs.css')\"",
    "dev": "NEXT_PUBLIC_APP_ENV=docs next --webpack -p 4000",
    "prebuild": "node -e \"const fs=require('fs'); const p=require.resolve('nextra-theme-docs/style.css'); fs.cpSync(p,'public/nextra-theme-docs.css')\"",
    "build": "node -v && NEXT_PUBLIC_APP_ENV=docs next build --webpack",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "NEXT_PUBLIC_APP_ENV=docs next start -p 4000",
    "env:local": "cp .env.example .env.local",
    "regenerate:docs": "npm -w @green-stack/core run run:script ../../apps/docs/scripts/regenerate-docs.ts"
  }
}
